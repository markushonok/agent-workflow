{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:review:design",
  "type": "object",
  "additionalProperties": false,
  "required": ["dimension", "finalized", "changed_files", "rules", "files", "findings"],
  "properties": {
    "dimension": {"const": "design"},
    "finalized": {"const": true},
    "changed_files": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "rules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["covered", "rules"],
        "properties": {
          "covered": {"const": true},
          "rules": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["file", "rule", "provision", "finding"],
        "properties": {
          "file": {"type": "string", "minLength": 1},
          "rule": {"type": "string", "minLength": 1},
          "provision": {"type": "string", "minLength": 1},
          "finding": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$comment": "Finalized ledger returned by specialized review. Validate.jq also checks scope/coverage agreement, rule membership and finding references. Ledger.sh json may emit unfinalized state without enforcing this contract."
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:review:behavior",
  "type": "object",
  "additionalProperties": false,
  "required": ["dimension", "finalized", "changed_files", "rules", "files", "findings"],
  "properties": {
    "dimension": {"const": "behavior"},
    "finalized": {"const": true},
    "changed_files": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "rules": {"const": []},
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["covered"], "properties": {"covered": {"const": true}}
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["file", "area", "scenario", "expected", "actual", "explanation"],
        "properties": {
          "file": {"type": "string", "minLength": 1},
          "area": {"type": "string", "minLength": 1},
          "scenario": {"type": "string", "minLength": 1},
          "expected": {"type": "string", "minLength": 1},
          "actual": {"type": "string", "minLength": 1},
          "explanation": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$comment": "Finalized ledger returned by specialized review. Validate.jq also checks scope/coverage agreement and finding references. Ledger.sh json may emit unfinalized state without enforcing this contract."
}
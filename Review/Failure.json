{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:review:failure",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "error"],
  "properties": {
    "status": {"const": "failed"},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "message"],
      "properties": {
        "kind": {
          "enum": [
            "configuration", "review_failed"
          ]
        },
        "message": {"type": "string", "minLength": 1}
      }
    }
  }
}